{
	"type": "module",
	"lint-staged": {
		"*.ts": "eslint --cache --fix",
		"*.{ts,css,md}": "prettier --write"
	},
	"scripts": {
		"prepare": "husky install",
		"lint": "eslint --cache --fix src",
		"prettier": "prettier --write \"src/**/*\"",
		"compile": "tsc && npm run copy",
		"clean": "rimraf dist/",
		"copy": "npx copyfiles -u 1 src/.env src/**/*.json dist/",
		"build": "npm run lint && npm run prettier && npm run clean && npm run compile",
		"start": "npx copyfiles -u 1 src/.env src/**/*.json dist/ && cd dist && node . && cd ..",
		"dev": "npm run clean && tsc-watch --onSuccess \"npm run start\"",
		"prod": "npm run build && npm run start"
	},
	"dependencies": {
		"@discordjs/rest": "^2.0.1",
		"@googleapis/docs": "^10.0.0",
		"@googleapis/drive": "^21.0.0",
		"better-sqlite3": "^13.0.3",
		"cr-numeral": "^2.1.0",
		"discord.js": "^14.13.0",
		"dotenv": "^16.3.1",
		"number-to-alphabet": "^1.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tsconfig/node20": "^20.1.10",
		"@types/better-sqlite3": "^9.6.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"tsc-watch": "^7.2.1",
		"typescript": "<6.1.0",
		"typescript-eslint": "^8.71.1"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true
	}
}
