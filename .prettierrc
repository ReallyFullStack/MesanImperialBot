{
	"$schema": "https://json.schemastore.org/prettierrc",
	"plugins": ["prettier-plugin-sql"],
	"semi": false,
	"singleQuote": true,
	"printWidth": 100,
	"tabWidth": 4,
	"useTabs": true,
	"language": "sqlite",
	"keywordCase": "upper",
	"dataTypeCase": "upper",
	"overrides": [
		{
			"files": ["*.ts.template"],
			"options": {
				"parser": "typescript"
			}
		}
	]
}
